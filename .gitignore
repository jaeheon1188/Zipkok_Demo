
# ==========================
# Zipkok - .gitignore
# ==========================

# 1. 운영체제 임시 파일
.DS_Store
Thumbs.db
desktop.ini

# 2. 개발 도구 설정
.vscode/
.idea/

# 3. 환경변수 및 비밀키
.env
.env.*
!.env.example
*.pem
*.key

# 4. Python / FastAPI
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 5. 데이터베이스
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# 6. JavaScript / Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 7. 임시 파일 및 로그
*.log
*.tmp
*.bak

# 8. 빌드 및 테스트 결과물
dist/
build/
coverage/
